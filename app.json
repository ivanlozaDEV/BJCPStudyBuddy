{
  "expo": {
    "name": "BrewStudy",
    "slug": "bjcp-study-buddy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F5D73"
    },
    "scheme": "bjcpstudybuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ivanloza.bjcpstudybuddy",
      "buildNumber": "9",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite a BrewStudy acceder a tu ubicación para registrar el bar o lugar donde realizas tus catas de cerveza.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "BJCP Tasting Scoresheet",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.ivanloza.bjcpstudybuddy.tasting"],
            "CFBundleTypeExtensions": ["bjcptasting"]
          },
          {
            "CFBundleTypeName": "BrewStudy Backup",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": ["com.ivanloza.bjcpstudybuddy.backup"],
            "CFBundleTypeExtensions": ["brewstudy"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.ivanloza.bjcpstudybuddy.tasting",
            "UTTypeDescription": "BJCP Tasting Scoresheet File",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["bjcptasting"],
              "public.mime-type": ["application/json"]
            }
          },
          {
            "UTTypeIdentifier": "com.ivanloza.bjcpstudybuddy.backup",
            "UTTypeDescription": "BrewStudy Backup File",
            "UTTypeConformsTo": ["public.data", "public.json"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["brewstudy"],
              "public.mime-type": ["application/json"]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ivanloza.bjcpstudybuddy",
      "versionCode": 9,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": [
            { "scheme": "file", "pathPattern": ".*\\.bjcptasting", "mimeType": "*/*" },
            { "scheme": "content", "pathPattern": ".*\\.bjcptasting", "mimeType": "*/*" },
            { "scheme": "file", "pathPattern": ".*\\.brewstudy", "mimeType": "*/*" },
            { "scheme": "content", "pathPattern": ".*\\.brewstudy", "mimeType": "*/*" }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F5D73",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a BrewStudy acceder a tus fotos para adjuntar imágenes a tus fichas de cata.",
          "cameraPermission": "Permite a BrewStudy usar la cámara para fotografiar las cervezas que estás evaluando."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite a BrewStudy acceder a tu ubicación para registrar el bar o lugar donde realizas tus catas de cerveza."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
