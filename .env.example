# Supabase Configuration for BrewStudy
# Replace with your actual project URL and Anon Public Key from https://app.supabase.com -> Project Settings -> API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# RevenueCat Configuration (App Store & Google Play In-App Subscriptions)
# Get your Public SDK Keys from https://app.revenuecat.com -> Project -> API Keys
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_apple_api_key_here
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_google_api_key_here
